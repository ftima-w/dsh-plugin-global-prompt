{
  "name": "dsh-plugin-global-prompt-switch",
  "description": "DSH 插件：在侧边栏底部新增「全局提示词」入口，用浮层面板编辑并注入每次对话（含已有会话与子代理）的系统提示词；修复了原版在 rc.5+ 下的客户端加载与焦点丢失问题。",
  "version": "5.0.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "prompt",
    "global-prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ftima-w/dsh-plugin-global-prompt.git"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "bugs": {
    "url": "https://github.com/ftima-w/dsh-plugin-global-prompt/issues"
  },
  "homepage": "https://github.com/ftima-w/dsh-plugin-global-prompt#readme",
  "author": {
    "name": "逐鹿科技 (chasechan)",
    "url": "https://gitee.com/chasechan/dsh-plugin-global-prompt"
  },
  "contributors": [
    {
      "name": "ftima-w",
      "url": "https://github.com/ftima-w"
    }
  ]
}
